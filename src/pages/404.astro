---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Página no encontrada | Roberto Dorado"
  description="La página solicitada no se ha encontrado."
  noindex
>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="eyebrow">Error 404</p>
    <h1 id="not-found-title">Página no encontrada</h1>
    <p>La dirección solicitada no existe o ya no está disponible.</p>
    <nav class="not-found-actions" aria-label="Opciones para continuar">
      <a class="button button-primary" href={base}>Volver al inicio</a>
      <a class="button button-secondary" href={`${base}proyectos/`}>Ver proyectos</a>
    </nav>
  </section>
</BaseLayout>
