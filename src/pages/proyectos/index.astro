---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectSections } from '../../lib/projectLabels';

const projects = await getCollection('projects');
const populatedSections = projectSections
  .map((section) => ({
    ...section,
    projects: projects.filter((project) => project.data.type === section.type),
  }))
  .filter((section) => section.projects.length > 0);
---

<BaseLayout
  title="Proyectos | Roberto Dorado"
  description="Aplicaciones, programas, webs y otros proyectos públicos de Roberto Dorado."
>
  <header class="page-header">
    <h1>Proyectos</h1>
    <p>Aplicaciones, programas, webs y otros proyectos públicos.</p>
  </header>

  <div class="project-sections">
    {populatedSections.map((section) => (
      <section class="project-section" aria-labelledby={`projects-${section.type}`}>
        <h2 id={`projects-${section.type}`}>{section.title}</h2>
        <ul class="project-grid">
          {section.projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
