---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Inicio', isCurrent: currentPath === '/' },
  {
    href: '/proyectos/',
    label: 'Proyectos',
    isCurrent: currentPath.startsWith('/proyectos'),
  },
];
---

<header class="site-header">
  <div class="container">
    <nav aria-label="Navegación principal">
      <ul>
        {links.map(({ href, label, isCurrent }) => (
          <li>
            <a href={href} aria-current={isCurrent ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
