---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const projectsPath = `${base}proyectos/`;

const links = [
  { href: base, label: 'Inicio', isCurrent: currentPath === base },
  {
    href: projectsPath,
    label: 'Proyectos',
    isCurrent: currentPath.startsWith(projectsPath),
  },
];
---

<header class="site-header">
  <div class="container">
    <nav aria-label="Navegación principal">
      <ul>
        {links.map(({ href, label, isCurrent }) => (
          <li>
            <a href={href} aria-current={isCurrent ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
